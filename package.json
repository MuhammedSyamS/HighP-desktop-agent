{
  "name": "highp-desktop-agent",
  "version": "1.0.0",
  "description": "HighP Workforce Transparency & Activity Desktop Agent",
  "author": "HighP Haus",
  "main": "./dist/main/index.js",
  "scripts": {
    "build:native": "node scripts/build-native.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:native && tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.js",
    "telemetry:diagnose": "ts-node src/scripts/diagnose.ts",
    "test": "ts-node src/scripts/test-cross-platform.ts",
    "test:scenarios": "ts-node src/scripts/test-tracking-scenarios.ts",
    "test:endurance": "ts-node src/scripts/test-endurance.ts",
    "tracking:reconcile": "ts-node src/scripts/tracking-reconcile.ts",
    "tracking:audit": "ts-node src/scripts/tracking-audit.ts",
    "verify:production-tracking": "ts-node src/scripts/verify-production-tracking.ts",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:all": "npm run build && electron-builder -mwl --publish never"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.highphaus.desktopagent",
    "productName": "HighP Agent",
    "electronVersion": "33.2.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "browser-extension/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64", "arm64"]
        }
      ],
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": ["**/*"]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64", "universal"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64", "universal"]
        }
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "HighP Agent"
    }
  }
}
